# Port aplikasi Gin akan berjalan.
APP_PORT=9099

# Secret key untuk sign JWT token.
# Untuk production, jangan pakai nilai default ini.
JWT_SECRET=change_this_secret_key

# Konfigurasi koneksi MySQL lokal.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=bootcamp_assignment

# Konfigurasi koneksi Redis (gunakan nilai dari Upstash).
REDIS_ADDR=redis-127.0.0.1
REDIS_USERNAME=root
REDIS_PASSWORD=password
REDIS_DB=0